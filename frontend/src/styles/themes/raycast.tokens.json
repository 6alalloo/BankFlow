{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "name": "bankflow-raycast",
  "status": "active-foundation",
  "source": "https://styles.refero.design/style/3b6a17f0-3bdf-418c-a95e-0b89e5a8b2f8",
  "description": "Inactive Raycast-inspired design tokens for the Bankflow redesign setup.",
  "colors": {
    "canvas": "#040506",
    "surface1": "#07080a",
    "surface2": "#111214",
    "surface3": "#1b1c1e",
    "textPrimary": "#ffffff",
    "textSecondary": "#9c9c9d",
    "textTertiary": "#6a6b6c",
    "borderSubtle": "rgba(255,255,255,0.08)",
    "borderStrong": "rgba(255,255,255,0.18)",
    "ember": "#ff6363",
    "emberDark": "#452324",
    "mint": "#59d499",
    "skyStart": "#56c2ff",
    "skyEnd": "#138af2"
  },
  "gradients": {
    "sky": "linear-gradient(135deg, #56c2ff 0%, #138af2 100%)",
    "nebula": "radial-gradient(84.6% 73.49% at 50% 26.51%, rgba(4,63,150,0.7), rgba(6,18,37,0.25))",
    "violet": "radial-gradient(86.88% 75.47% at 50% 24.53%, rgba(82,48,145,0.7), rgba(26,11,51,0.14))"
  },
  "radii": {
    "control": "8px",
    "nav": "11px",
    "panel": "16px",
    "large": "20px"
  },
  "shadows": {
    "keyboardKey": "rgba(0,0,0,0.4) 0px 1.5px 0.5px 2.5px, rgb(0,0,0) 0px 0px 0.5px 1px, rgba(0,0,0,0.25) 0px 2px 1px 1px inset, rgba(255,255,255,0.2) 0px 1px 1px 1px inset",
    "interactiveRing": "rgb(27,28,30) 0px 0px 0px 1px, rgb(7,8,10) 0px 0px 0px 1px inset",
    "highlightCard": "rgba(255,255,255,0.05) 0px 1px 0px 0px inset, rgba(255,255,255,0.18) 0px 0px 0px 1px, rgba(0,0,0,0.2) 0px -1px 0px 0px inset"
  },
  "typography": {
    "sans": "\"Geist\", Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "\"Geist Mono\", \"JetBrains Mono\", \"IBM Plex Mono\", ui-monospace, monospace",
    "display": {
      "fontWeight": 600,
      "lineHeight": 1.1,
      "letterSpacing": "-0.002em"
    },
    "microLabel": {
      "fontSize": "11px",
      "fontWeight": 500,
      "lineHeight": 1.2,
      "letterSpacing": "0.073em"
    }
  },
  "usage": {
    "primaryAction": "near-white pill/button on dark surface",
    "dangerOrRisk": "ember only",
    "successOrHealthy": "mint only",
    "numericData": "mono font with positive tracking",
    "surfaceSeparation": "charcoal strata, inset highlights, and monochrome shadows"
  }
}

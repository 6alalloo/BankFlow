# BankFlow Environment Configuration
# Copy this file to backend/.env and fill in your values.

# ============================================
# Database
# ============================================

# Docker dev default - change for staging/prod
DATABASE_URL=postgresql://bankflow:bankflow_dev@localhost:5433/bankflow

# ============================================
# Security
# ============================================

# Use a long random secret in every non-dev environment
JWT_SECRET=replace-with-a-long-random-secret

# ============================================
# Server
# ============================================

PORT=3000

# ============================================
# Optional
# ============================================

DEFAULT_EMAIL_SENDER=noreply@bankflow.local
DEFAULT_EMAIL_RECIPIENT=ops@bankflow.local

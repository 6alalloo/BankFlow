// BankFlow active schema.
//
// This schema is the hard-cutover BankFlow domain model for case-flow
// authoring and governed case runtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum case_flow_status {
  draft
  published
  archived
}

enum case_flow_version_status {
  published
  superseded
  archived
}

enum case_status {
  intake
  in_review
  pending_approval
  pending_action
  escalated
  resolved
  closed
  cancelled
}

enum case_priority {
  low
  normal
  high
  critical
}

enum case_task_status {
  pending
  assigned
  claimed
  completed
  rejected
  cancelled
  overdue
}

enum case_task_type {
  review
  data_capture
  approval_support
  document_collection
  decision_followup
  escalation_followup
}

enum case_event_type {
  case_created
  status_updated
  task_created
  task_claimed
  task_completed
  approval_requested
  approval_decided
  escalation_triggered
  escalation_resolved
  document_uploaded
  automation_requested
  automation_completed
  automation_failed
  note_added
  case_resolved
  case_closed
  case_cancelled
}

enum case_approval_status {
  requested
  approved
  rejected
  expired
  cancelled
}

enum case_escalation_status {
  triggered
  resolved
  cancelled
}

enum claim_policy {
  direct_assign
  claim_required
}

model audit_logs {
  id            Int      @id @default(autoincrement())
  actor_user_id Int?
  action        String   @db.VarChar
  entity_type   String?  @db.VarChar
  entity_id     Int?
  data_json     String?  @db.VarChar
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([actor_user_id], map: "idx_audit_actor")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
}

model roles {
  id                                 Int              @id @default(autoincrement())
  name                               String           @unique @db.VarChar
  created_at                         DateTime         @default(now()) @db.Timestamptz(6)
  case_approvals_requested_from_role case_approvals[] @relation("case_approvals_requested_from_role")
  users                              users[]
}

model users {
  id                                 Int                  @id @default(autoincrement())
  email                              String               @unique @db.VarChar
  password_hash                      String               @db.VarChar
  full_name                          String               @db.VarChar
  is_active                          Boolean              @default(true)
  role_id                            Int
  created_at                         DateTime             @default(now()) @db.Timestamptz(6)
  assigned_case_tasks                case_tasks[]         @relation("case_tasks_assigned_user")
  completed_case_tasks               case_tasks[]         @relation("case_tasks_completed_by")
  published_case_flow_versions       case_flow_versions[] @relation("case_flow_versions_published_by")
  assigned_cases                     cases[]              @relation("cases_assignee_user")
  created_cases                      cases[]              @relation("cases_created_by")
  owned_case_flows                   case_flows[]         @relation("case_flows_owner")
  case_approvals_decided_by_user     case_approvals[]     @relation("case_approvals_decided_by")
  case_approvals_requested_from_user case_approvals[]     @relation("case_approvals_requested_from_user")
  case_documents_uploaded_by_user    case_documents[]     @relation("case_documents_uploaded_by")
  case_escalations_from_user         case_escalations[]   @relation("case_escalations_from_user")
  case_escalations_resolved_by_user  case_escalations[]   @relation("case_escalations_resolved_by")
  case_escalations_to_user           case_escalations[]   @relation("case_escalations_to_user")
  case_events_actor                  case_events[]        @relation("case_events_actor")
  audit_logs                         audit_logs[]
  http_allow_list_domains            http_allow_list_domains[]
  roles                              roles                @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  team_memberships                   team_memberships[]

  @@index([role_id], map: "idx_users_role_id")
}

model http_allow_list_domains {
  id         Int      @id @default(autoincrement())
  domain     String   @unique @db.VarChar(255)
  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([created_by], map: "idx_http_allow_list_created_by")
}

model teams {
  id                                 Int                @id @default(autoincrement())
  key                                String             @unique @db.VarChar(100)
  name                               String             @db.VarChar
  description                        String?            @db.VarChar
  is_active                          Boolean            @default(true)
  created_at                         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  assigned_case_tasks                case_tasks[]       @relation("case_tasks_assigned_team")
  assigned_cases                     cases[]            @relation("cases_assignee_team")
  requested_case_approvals_from_team case_approvals[]   @relation("case_approvals_requested_from_team")
  to_case_escalations                case_escalations[] @relation("case_escalations_to_team")
  team_memberships                   team_memberships[]
}

model team_memberships {
  id              Int      @id @default(autoincrement())
  team_id         Int
  user_id         Int
  membership_role String?  @db.VarChar
  is_primary      Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  teams           teams    @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([team_id, user_id], map: "uq_team_memberships_team_user")
  @@index([user_id], map: "idx_team_memberships_user")
}

model case_flows {
  id                           Int                  @id @default(autoincrement())
  key                          String               @unique @db.VarChar(100)
  name                         String               @db.VarChar
  description                  String?              @db.VarChar
  case_type                    String               @db.VarChar
  status                       case_flow_status     @default(draft)
  owner_user_id                Int?
  current_published_version_id Int?                 @unique
  draft_data_schema_json       Json?
  created_at                   DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  archived_at                  DateTime?            @db.Timestamptz(6)
  case_flow_draft_edges        case_flow_draft_edges[]
  case_flow_draft_nodes        case_flow_draft_nodes[]
  case_flow_versions           case_flow_versions[] @relation("case_flow_versions_case_flow")
  cases                        cases[]
  current_published_version    case_flow_versions?  @relation("case_flows_current_published_version", fields: [current_published_version_id], references: [id], onUpdate: NoAction)
  owners                       users?               @relation("case_flows_owner", fields: [owner_user_id], references: [id], onUpdate: NoAction)

  @@index([archived_at], map: "idx_case_flows_archived")
  @@index([owner_user_id], map: "idx_case_flows_owner")
  @@index([status], map: "idx_case_flows_status")
}

model case_flow_draft_nodes {
  id           Int        @id @default(autoincrement())
  case_flow_id Int
  node_key     String     @db.VarChar(100)
  kind         String     @db.VarChar(50)
  name         String?    @db.VarChar
  config_json  Json
  pos_x        Int        @default(0)
  pos_y        Int        @default(0)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  case_flows   case_flows @relation(fields: [case_flow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([case_flow_id, node_key], map: "uq_case_flow_draft_nodes_flow_node_key")
  @@index([case_flow_id], map: "idx_case_flow_draft_nodes_flow")
  @@index([kind], map: "idx_case_flow_draft_nodes_kind")
}

model case_flow_draft_edges {
  id             Int        @id @default(autoincrement())
  case_flow_id   Int
  edge_key       String     @db.VarChar(100)
  from_node_key  String     @db.VarChar(100)
  to_node_key    String     @db.VarChar(100)
  condition_json Json?
  label          String?    @db.VarChar
  priority       Int        @default(0)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  case_flows     case_flows @relation(fields: [case_flow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([case_flow_id, edge_key], map: "uq_case_flow_draft_edges_flow_edge_key")
  @@index([case_flow_id, from_node_key], map: "idx_case_flow_draft_edges_from")
  @@index([case_flow_id, to_node_key], map: "idx_case_flow_draft_edges_to")
}

model case_flow_versions {
  id                     Int                      @id @default(autoincrement())
  case_flow_id           Int
  version_number         Int
  status                 case_flow_version_status @default(published)
  graph_json             Json
  data_schema_json       Json?
  change_summary         String?                  @db.VarChar
  published_by_user_id   Int?
  published_at           DateTime                 @default(now()) @db.Timestamptz(6)
  retired_at             DateTime?                @db.Timestamptz(6)
  case_flows             case_flows               @relation("case_flow_versions_case_flow", fields: [case_flow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cases                  cases[]
  current_for_case_flows case_flows?              @relation("case_flows_current_published_version")
  published_by_user      users?                   @relation("case_flow_versions_published_by", fields: [published_by_user_id], references: [id], onUpdate: NoAction)

  @@unique([case_flow_id, version_number], map: "uq_case_flow_versions_flow_version")
  @@index([published_by_user_id], map: "idx_case_flow_versions_published_by")
  @@index([status], map: "idx_case_flow_versions_status")
}

model cases {
  id                   Int                @id @default(autoincrement())
  case_flow_id         Int
  case_flow_version_id Int
  case_reference       String             @unique @db.VarChar(100)
  case_type            String             @db.VarChar
  title                String?            @db.VarChar
  status               case_status        @default(intake)
  priority             case_priority      @default(normal)
  current_node_key     String?            @db.VarChar(100)
  current_task_id      Int?
  assignee_user_id     Int?
  assignee_team_id     Int?
  intake_source        String?            @db.VarChar
  case_data_json       Json?
  flow_snapshot_json   Json
  outcome_json         Json?
  opened_at            DateTime           @default(now()) @db.Timestamptz(6)
  resolved_at          DateTime?          @db.Timestamptz(6)
  closed_at            DateTime?          @db.Timestamptz(6)
  created_by_user_id   Int?
  assignee_team        teams?             @relation("cases_assignee_team", fields: [assignee_team_id], references: [id], onUpdate: NoAction)
  assignee_user        users?             @relation("cases_assignee_user", fields: [assignee_user_id], references: [id], onUpdate: NoAction)
  case_documents       case_documents[]
  case_approvals       case_approvals[]
  case_escalations     case_escalations[]
  case_events          case_events[]
  case_flow_versions   case_flow_versions @relation(fields: [case_flow_version_id], references: [id], onUpdate: NoAction)
  case_flows           case_flows         @relation(fields: [case_flow_id], references: [id], onUpdate: NoAction)
  case_tasks           case_tasks[]
  created_by_user      users?             @relation("cases_created_by", fields: [created_by_user_id], references: [id], onUpdate: NoAction)

  @@index([assignee_team_id], map: "idx_cases_assignee_team")
  @@index([assignee_user_id], map: "idx_cases_assignee_user")
  @@index([case_flow_id], map: "idx_cases_flow")
  @@index([case_flow_version_id], map: "idx_cases_flow_version")
  @@index([current_node_key], map: "idx_cases_current_node_key")
  @@index([status], map: "idx_cases_status")
}

model case_tasks {
  id                   Int              @id @default(autoincrement())
  case_id              Int
  flow_node_key        String           @db.VarChar(100)
  task_type            case_task_type
  title                String           @db.VarChar
  status               case_task_status @default(pending)
  assigned_user_id     Int?
  assigned_team_id     Int?
  claim_policy         claim_policy     @default(claim_required)
  claimed_at           DateTime?        @db.Timestamptz(6)
  due_at               DateTime?        @db.Timestamptz(6)
  completed_at         DateTime?        @db.Timestamptz(6)
  decision             String?          @db.VarChar
  input_json           Json?
  output_json          Json?
  completed_by_user_id Int?
  assigned_team        teams?           @relation("case_tasks_assigned_team", fields: [assigned_team_id], references: [id], onUpdate: NoAction)
  assigned_user        users?           @relation("case_tasks_assigned_user", fields: [assigned_user_id], references: [id], onUpdate: NoAction)
  case_approvals       case_approvals[]
  case_documents       case_documents[]
  case_escalations     case_escalations[]
  case_events          case_events[]
  cases                cases            @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  completed_by_user    users?           @relation("case_tasks_completed_by", fields: [completed_by_user_id], references: [id], onUpdate: NoAction)

  @@index([assigned_team_id], map: "idx_case_tasks_assigned_team")
  @@index([assigned_user_id], map: "idx_case_tasks_assigned_user")
  @@index([case_id], map: "idx_case_tasks_case")
  @@index([due_at], map: "idx_case_tasks_due_at")
  @@index([status], map: "idx_case_tasks_status")
}

model case_events {
  id            Int             @id @default(autoincrement())
  case_id       Int
  flow_node_key String?         @db.VarChar(100)
  task_id       Int?
  actor_user_id Int?
  event_type    case_event_type
  summary       String?         @db.VarChar
  data_json     Json?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  actor_user    users?          @relation("case_events_actor", fields: [actor_user_id], references: [id], onUpdate: NoAction)
  case_tasks    case_tasks?     @relation(fields: [task_id], references: [id], onUpdate: NoAction)
  cases         cases           @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_user_id], map: "idx_case_events_actor")
  @@index([case_id], map: "idx_case_events_case")
  @@index([event_type], map: "idx_case_events_type")
  @@index([task_id], map: "idx_case_events_task")
}

model case_approvals {
  id                         Int                  @id @default(autoincrement())
  case_id                    Int
  task_id                    Int?
  flow_node_key              String               @db.VarChar(100)
  approval_label             String               @db.VarChar
  status                     case_approval_status @default(requested)
  requested_from_user_id     Int?
  requested_from_role_id     Int?
  requested_from_team_id     Int?
  requested_at               DateTime             @default(now()) @db.Timestamptz(6)
  due_at                     DateTime?            @db.Timestamptz(6)
  decided_at                 DateTime?            @db.Timestamptz(6)
  decided_by_user_id         Int?
  required_comment           Boolean              @default(false)
  decision_reason            String?              @db.VarChar
  cases                      cases                @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  case_tasks                 case_tasks?          @relation(fields: [task_id], references: [id], onUpdate: NoAction)
  decided_by_user            users?               @relation("case_approvals_decided_by", fields: [decided_by_user_id], references: [id], onUpdate: NoAction)
  requested_from_role        roles?               @relation("case_approvals_requested_from_role", fields: [requested_from_role_id], references: [id], onUpdate: NoAction)
  requested_from_team        teams?               @relation("case_approvals_requested_from_team", fields: [requested_from_team_id], references: [id], onUpdate: NoAction)
  requested_from_user        users?               @relation("case_approvals_requested_from_user", fields: [requested_from_user_id], references: [id], onUpdate: NoAction)

  @@index([case_id], map: "idx_case_approvals_case")
  @@index([requested_from_role_id], map: "idx_case_approvals_role")
  @@index([requested_from_team_id], map: "idx_case_approvals_team")
  @@index([requested_from_user_id], map: "idx_case_approvals_user")
  @@index([status], map: "idx_case_approvals_status")
  @@index([task_id], map: "idx_case_approvals_task")
}

model case_escalations {
  id                  Int                    @id @default(autoincrement())
  case_id             Int
  source_task_id      Int?
  flow_node_key       String?                @db.VarChar(100)
  escalation_type     String                 @db.VarChar
  status              case_escalation_status @default(triggered)
  reason              String                 @db.VarChar
  from_user_id        Int?
  to_user_id          Int?
  to_team_id          Int?
  triggered_at        DateTime               @default(now()) @db.Timestamptz(6)
  resolved_at         DateTime?              @db.Timestamptz(6)
  resolved_by_user_id Int?
  cases               cases                  @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  from_user           users?                 @relation("case_escalations_from_user", fields: [from_user_id], references: [id], onUpdate: NoAction)
  resolved_by_user    users?                 @relation("case_escalations_resolved_by", fields: [resolved_by_user_id], references: [id], onUpdate: NoAction)
  source_task         case_tasks?            @relation(fields: [source_task_id], references: [id], onUpdate: NoAction)
  to_team             teams?                 @relation("case_escalations_to_team", fields: [to_team_id], references: [id], onUpdate: NoAction)
  to_user             users?                 @relation("case_escalations_to_user", fields: [to_user_id], references: [id], onUpdate: NoAction)

  @@index([case_id], map: "idx_case_escalations_case")
  @@index([source_task_id], map: "idx_case_escalations_source_task")
  @@index([status], map: "idx_case_escalations_status")
  @@index([to_team_id], map: "idx_case_escalations_team")
  @@index([to_user_id], map: "idx_case_escalations_user")
}

model case_documents {
  id                  Int         @id @default(autoincrement())
  case_id             Int
  task_id             Int?
  flow_node_key       String?     @db.VarChar(100)
  filename            String      @db.VarChar
  mime_type           String      @db.VarChar
  storage_path        String      @db.VarChar
  document_type       String?     @db.VarChar
  metadata_json       Json?
  uploaded_by_user_id Int?
  uploaded_at         DateTime    @default(now()) @db.Timestamptz(6)
  case_tasks          case_tasks? @relation(fields: [task_id], references: [id], onUpdate: NoAction)
  cases               cases       @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploaded_by_user    users?      @relation("case_documents_uploaded_by", fields: [uploaded_by_user_id], references: [id], onUpdate: NoAction)

  @@index([case_id], map: "idx_case_documents_case")
  @@index([task_id], map: "idx_case_documents_task")
  @@index([uploaded_by_user_id], map: "idx_case_documents_uploaded_by")
}

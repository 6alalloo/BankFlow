# BankFlow Environment Configuration
# Copy this file to .env and replace placeholder values for your environment.

# ============================================
# Security
# ============================================

# Use a long random secret in every non-demo environment
JWT_SECRET=replace-with-a-long-random-secret

# ============================================
# Optional Configuration
# ============================================

DEFAULT_EMAIL_SENDER=noreply@bankflow.local
DEFAULT_EMAIL_RECIPIENT=ops@bankflow.local
